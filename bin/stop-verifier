#!/usr/bin/env bash
# stop-verifier

# export TACC_SYNC_WORK_ROOT=${TACC_SYNC_WORK_ROOT:="${HOME}/tacc-sync/work"}
export TACC_SYNC_WORK_ROOT=${TACC_SYNC_WORK_ROOT:="/tmp/tacc/work"}
export PID_PATH=${PID_PATH:="${TACC_SYNC_WORK_ROOT}/semaphore/verifier-host-randhex.pid"}

# these processes are run in parallel; so PID files will vary
echo "Check semaphore directory: ${PID_PATH}"
exit 1

# if there is no pid file, there is nothing for us to do
if [[ ! -f $PID_PATH ]]; then
    echo "Verifier component has no pid file at: $PID_PATH"
    exit 1
fi

# kill the existing Verifier process
kill -9 $(<$PID_PATH)

# delete the now obsolete pid file
rm -v "$PID_PATH"
