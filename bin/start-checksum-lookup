#!/usr/bin/env bash
# start-checksum-lookup

# application configuration (Production)
# export TACC_SYNC_DATA_ROOT=${TACC_SYNC_DATA_ROOT:="${CFS}/icecubed/tacc-sync"}
# export TACC_SYNC_ROOT=${TACC_SYNC_ROOT:="${HOME}/tacc-sync"}
# export TACC_SYNC_WORK_ROOT=${TACC_SYNC_WORK_ROOT:="${HOME}/tacc-sync/work"}

# application configuration (Development)
export TACC_SYNC_DATA_ROOT=${TACC_SYNC_DATA_ROOT:="/tmp/tacc/data"}
export TACC_SYNC_ROOT=${TACC_SYNC_ROOT:="${HOME}/github/tacc-sync"}
export TACC_SYNC_WORK_ROOT=${TACC_SYNC_WORK_ROOT:="/tmp/tacc/work"}

# source our Python environment
cd ${TACC_SYNC_ROOT}
source env/bin/activate

# component configuration
: ${AUTH_OPENID_URL:="https://keycloak.icecube.wisc.edu/auth/realms/IceCube"}
: ${CLIENT_ID:="long-term-archive"}
: ${CLIENT_SECRET:="$(<keycloak-client-secret)"}
: ${FILE_CATALOG_REST_URL:="https://file-catalog.icecube.wisc.edu"}
: ${INBOX_DIR:="${TACC_SYNC_WORK_ROOT}/checksum_queue"}
: ${JADE_LTA_DB_PATH:="jade-lta-db.json"}
: ${LOG_LEVEL:="DEBUG"}
: ${LOG_PATH:="${TACC_SYNC_WORK_ROOT}/log/checksum_lookup.log"}
: ${OUTBOX_DIR:="${TACC_SYNC_WORK_ROOT}/hpss_queue"}
: ${PID_PATH:="${TACC_SYNC_WORK_ROOT}/semaphore/checksum_lookup.pid"}
: ${QUARANTINE_DIR:="${TACC_SYNC_WORK_ROOT}/quarantine/checksum_lookup"}
: ${RUN_ONCE_AND_DIE:="TRUE"}
: ${SEMAPHORE_DIR:="${TACC_SYNC_WORK_ROOT}/semaphore"}
: ${WORK_SLEEP_SECONDS:="3600"}  # 1 hour

# if we've already got a .pid file, then bail out
if [[ -f $PID_PATH ]]; then
    echo "Checksum-Lookup component is already running: $PID_PATH"
    echo "kill -9 $(<$PID_PATH)"
    exit 1
fi

# start the Checksum-Lookup component
echo "Starting Checksum-Lookup component"
python3 python/nersc/checksum_lookup.py &

# capture the process ID of the component
echo $! >$PID_PATH
